create database employeedb;
use employeedb;
CREATE TABLE employees (
    id VARCHAR(20) PRIMARY KEY,
    name VARCHAR(25) NOT NULL,
    email VARCHAR(30) NOT NULL,
    address TEXT NOT NULL,
    salary NUMERIC(10,2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
create table users(username varchar(25) primary key,
password varchar(256)not null,
created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP);

create table user_roles(username varchar(25) ,
role varchar(30),
primary key(username, role ),
constraint fk_user 
foreign key (username)
references users(username)
on delete cascade
);
ALTER TABLE users ADD id VARCHAR(10);
INSERT INTO users (username, password, id)
VALUES (
  'superadmin',
  '4e4c56e4a15f89f05c2f4c72613da2a18c9665d4f0d6acce16415eb06f9be776',
  NULL
);
INSERT INTO user_roles (username, role)
VALUES ('superadmin', 'SUPERADMIN');
ALTER TABLE employees
MODIFY id VARCHAR(10) NOT NULL;
CREATE TABLE emp_sequence (
    seq INT AUTO_INCREMENT PRIMARY KEY
);
INSERT INTO emp_sequence VALUES (NULL);
DELIMITER $$

CREATE TRIGGER before_employee_insert
BEFORE INSERT ON employees
FOR EACH ROW
BEGIN
    DECLARE next_id INT;

    INSERT INTO emp_sequence VALUES (NULL);
    SET next_id = LAST_INSERT_ID();

    SET NEW.id = CONCAT('EMP', LPAD(next_id, 3, '0'));
END$$

DELIMITER ;
select* from employees;
select * from users;
select* from user_roles;

CREATE TRIGGER before_employee_insert
BEFORE INSERT ON employees
FOR EACH ROW
SET NEW.id = CONCAT('EMP', LPAD(
    (SELECT IFNULL(MAX(CAST(SUBSTRING(id, 4) AS UNSIGNED)), 0) + 1 FROM employees),
    3,
    '0'
));
DROP TRIGGER IF EXISTS before_employee_insert;
ALTER TABLE employees ADD COLUMN active BOOLEAN DEFAULT TRUE;

ALTER TABLE users ADD COLUMN active BOOLEAN DEFAULT TRUE;



